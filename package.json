{
  "name": "docker-cicd-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Docker CI/CD Starter Platform - Cloud/DevOps Engineering Portfolio Project",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
