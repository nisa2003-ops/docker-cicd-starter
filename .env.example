# Docker CI/CD Starter Platform - Environment Variables
# Copy to .env in backend/ or frontend/ for local development

# Backend
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000/api
