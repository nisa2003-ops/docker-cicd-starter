# Backend Configuration (FastAPI)
# Copy to .env and adjust as needed

ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional CI/CD provider configuration (leave empty if not connected yet)
# Supported values: github-actions, local, or leave empty for unconfigured state
CI_PROVIDER=
CI_REPOSITORY=
